# Copy to .env and fill in real values (shared privately in team chat — never commit .env)

# Tiger Data (Postgres with vector search) — Teammate 2
DATABASE_URL=

# Gemini (Google AI Studio) — Teammate 3
GEMINI_API_KEY=
# Optional. Defaults live in api/services/gemini.py (Flash + 768-d embedding).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# Speak For Me suggestions stay on the local mock compose until this is 1.
# SUGGEST_USE_LLM=0

# ElevenLabs — Teammate 1
ELEVENLABS_ID=
ELEVENLABS_STORY_AGENT_ID=
ELEVENLABS_COACH_AGENT_ID=
# Optional. Defaults live in api/services/elevenlabs.py.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_FALLBACK_VOICE_ID=
# AUDIO_CACHE_DIR=api/audio-cache

# Cloudinary — Teammate 4
CLOUDINARY_CLOUD_NAME=
# Public twin of the cloud name above, needed by any "use client" component
# (TileButton in components/shared.tsx) that builds a Cloudinary URL in the
# browser. Not a secret — safe to expose. Keep this equal to CLOUDINARY_CLOUD_NAME.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Backend URL the web app calls
API_BASE_URL=http://localhost:8000

# MCP server URLs (streamable HTTP)
MCP_PROFILE_URL=http://localhost:8101
MCP_MEMORY_URL=http://localhost:8102
MCP_ACTIONS_URL=http://localhost:8103
MCP_EMH_URL=http://localhost:8104

# Email sender for the send_message action (email, not SMS)
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=

# Google Calendar (My Planner): the actions server writes approved staff visits here.
# Service account key: a path (relative to the repo root, e.g. inmyways-xxxx.json, which
# is gitignored) or the JSON inline. Empty = DB-only: visits still book in the app.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Where each staff member's visits land: "sam=sam@example.org,priya=..." or one calendar id
# for every visit (demo). Share each calendar with the service account ("make changes to events").
GOOGLE_CALENDAR_STAFF_EMAILS=
# Planner subagent: Gemini writes the events through MCP; plain code finishes anything it can't.
# PLANNER_GEMINI=0 forces the deterministic route. Per-request Gemini deadline in ms:
PLANNER_GEMINI=
PLANNER_GEMINI_TIMEOUT_MS=12000
