# Environment & secrets — real values are shared privately, never committed
.env
.env.local
.env*.local
*.pem
inmyways-*.json

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Seed-mode shared runtime state (bookings etc. before the real DB exists)
db/seed/.runtime.json

# Playwright output
web/test-results/
web/playwright-report/
web/blob-report/

# Playwright output
web/test-results/
web/playwright-report/
web/blob-report/

# Generated audio cache (regenerate, don't commit)
audio-cache/
*.mp3
!docs/**/*.mp3

# Generated messy seed photos — recreate with api/scripts/process_seed_photos.py
db/seed/photos/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

